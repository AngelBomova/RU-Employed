# Copy this file to ".env" (same folder) and fill in your keys.
# .env is in .gitignore, so your keys never get uploaded to GitHub.

# The AI brain — set ONE of these (if both are set, Claude is used unless AI_PROVIDER says otherwise)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ElevenLabs — interviewer voice + transcribing your spoken answers
ELEVENLABS_API_KEY=

# Optional overrides
# AI_PROVIDER=openai            # or claude
# OPENAI_MODEL=gpt-4o
# CLAUDE_MODEL=claude-opus-5-5
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v1
# PORT=3000

# Local accounts work without any external database or email service.
# AUTH_MODE=local               # force SQLite even when Supabase keys exist
# LOCAL_DATABASE_PATH=.data/ru-employed.sqlite

# Accounts + private PostgreSQL storage (apply supabase/migrations/001_workspace.sql)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Use the legacy anon JWT key from Supabase API settings, not a service-role key.
# Set Auth Site URL and email templates as described in docs/DEPLOYMENT.md.
PUBLIC_APP_URL=http://localhost:3000

# Optional Judge0 execution for Python, Java and C++; JavaScript has a local sandbox
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_AUTH_TOKEN=
# JUDGE0_API_KEY is for a RapidAPI-hosted endpoint; JUDGE0_AUTH_TOKEN is
# for a private Judge0 service. Choose the authentication your host requires.

# Production only: NODE_ENV=production, PUBLIC_APP_URL=https://ruemployed.io
# Render runs behind one trusted proxy. Leave unset for direct local hosting.
# TRUST_PROXY=1
